}

model admin_permissions {
  id            Int       @id @default(autoincrement())
  pidPermission String    @unique()
  pidUser       String
  serviceKey    String    @db.VarChar(100)
  canView       Boolean   @default(true)
  canEdit       Boolean   @default(false)
  createdAt     DateTime? @default(now())
  updatedAt     DateTime?
  admin         admin     @relation(fields: [pidUser], references: [pidUser], onDelete: Cascade, onUpdate: Cascade)

  @@unique([pidUser, serviceKey], map: "admin_permissions_pidUser_serviceKey_key")
  @@index([pidUser], map: "admin_permissions_pidUser_idx")
  @@index([serviceKey], map: "admin_permissions_serviceKey_idx")
}

model social_campaign {
  id                 Int                  @id @default(autoincrement())
  pidCampaign        String               @unique() @db.VarChar(80)
  sourceType         String               @db.VarChar(40)
