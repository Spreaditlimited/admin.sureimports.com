model blog {
  id            Int             @id @default(autoincrement())
  pidBlog       String          @unique(map: "Blog_pidBlog_key")
  blogTitle     String          @db.VarChar(255)
  blogContent   String?         @db.LongText
  blogSlug      String?         @db.VarChar(500)
  blogPublished Boolean         @default(false)
  blogFeatured  Boolean         @default(false)
  blogImage     String?         @db.VarChar(255)
  blogBy        String?         @db.VarChar(100)
  publisherId   String?
  blogExt1      String?         @db.Text
  blogExt2      String?         @db.Text
  categoryId    String?
  xStaus        String?         @db.VarChar(50)
  createdAt     DateTime?       @default(now())
  updatedAt     DateTime?
  category      blog_category?  @relation(fields: [categoryId], references: [pidCategory])
  publisher     blog_publisher? @relation(fields: [publisherId], references: [pidPublisher])

  @@index([categoryId])
  @@index([publisherId])
}

model blog_publisher {
  id                       Int       @id @default(autoincrement())
  pidPublisher             String    @unique()
  publisherName            String    @db.VarChar(100)
  publisherSlug            String?   @db.VarChar(100)
  publisherEmail           String?   @db.VarChar(255)
  publisherBio             String?   @db.Text
  publisherRole            String?   @db.VarChar(100)
  publisherImage           String?   @db.VarChar(255)
  publisherSocialX         String?   @db.VarChar(255)
  publisherSocialLinkedin  String?   @db.VarChar(255)
  publisherSocialFacebook  String?   @db.VarChar(255)
  publisherSocialInstagram String?   @db.VarChar(255)
  publisherWebsite         String?   @db.VarChar(255)
  status                   String?   @default("active") @db.VarChar(20)
  createdAt                DateTime? @default(now())
  updatedAt                DateTime?
  blogs                    blog[]
}

model blog_category {
  id                  Int       @id @default(autoincrement())
  pidCategory         String    @unique()
  categoryName        String    @db.VarChar(100)
  categorySlug        String?   @db.VarChar(100)
  categoryDescription String?   @db.Text
  categoryColor       String?   @db.VarChar(20)
  categoryIcon        String?   @db.VarChar(50)
  categoryOrder       Int?      @default(0)
  status              String?   @default("active") @db.VarChar(20)
  createdAt           DateTime? @default(now())
  updatedAt           DateTime?
  blogs               blog[]
}

model contact {
  id             Int       @id @default(autoincrement())
  pidContact     String    @unique(map: "Contact_pidContact_key")
  contactSubject String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  contactMessage String?
  contactStatus  String?
  contactExt1    String?
  contactExt2    String?
  xStaus         String?
  createdAt      DateTime? @default(now())
  updatedAt      DateTime?
}

model faqs {
  id          Int       @id @default(autoincrement())
  pidFaq      String    @unique(map: "Faqs_pidFaq_key")
  faqQuestion String?
  faqAnswer   String?
  faqStatus   String?
  faqExt1     String?
  faqExt2     String?
  xStatus     String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime?
}

model marketing_leads {
  id          Int       @id @default(autoincrement())
  pidLead     String    @unique()
  firstName   String?   @db.VarChar(100)
  email       String    @db.VarChar(255)
  segmentId   String?   @db.VarChar(100)
  source      String?   @db.VarChar(100)
  pageType    String?   @db.VarChar(50)
  pageUrl     String?   @db.Text
  pathname    String?   @db.VarChar(500)
  referrer    String?   @db.Text
  utmSource   String?   @db.VarChar(255)
  utmMedium   String?   @db.VarChar(255)
  utmCampaign String?   @db.VarChar(255)
  utmContent  String?   @db.VarChar(255)
  utmTerm     String?   @db.VarChar(255)
  fbclid      String?   @db.Text
  fbp         String?   @db.VarChar(255)
  fbc         String?   @db.VarChar(255)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime?

  @@index([email])
  @@index([createdAt])
  @@index([pageType])
  @@index([pathname])
  @@index([utmSource])
  @@index([utmCampaign])
}

model marketing_contacts {
  id                    Int                     @id @default(autoincrement())
  pidContact            String                  @unique @db.VarChar(80)
  email                 String                  @unique @db.VarChar(255)
  firstName             String?                 @db.VarChar(100)
  lastName              String?                 @db.VarChar(100)
  status                String                  @default("ACTIVE") @db.VarChar(40)
  consentStatus         String                  @default("OPTED_IN") @db.VarChar(40)
  consentSource         String?                 @db.VarChar(120)
  consentContext        Json?
  consentAt             DateTime?
  optInTokenHash        String?                 @unique @db.Char(64)
  optInRequestedAt      DateTime?
  optInExpiresAt        DateTime?
  unsubscribedAt        DateTime?
  bouncedAt             DateTime?
  complainedAt          DateTime?
  sesVerificationStatus String                  @default("UNVERIFIED") @db.VarChar(40)
  sesContactSyncedAt    DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  enrollments           marketing_enrollments[]
  deliveries            marketing_deliveries[]

  @@index([status])
  @@index([consentStatus])
  @@index([createdAt])
}

model marketing_sequences {
  id          Int                        @id @default(autoincrement())
  pidSequence String                     @unique @db.VarChar(80)
  name        String                     @db.VarChar(180)
  description String?                    @db.Text
  triggerKey  String?                    @db.VarChar(100)
  cadence     String                     @default("WEEKLY") @db.VarChar(40)
  status      String                     @default("DRAFT") @db.VarChar(40)
  totalSteps  Int                        @default(0)
  createdBy   String?                    @db.VarChar(80)
  activatedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  steps       marketing_sequence_steps[]
  enrollments marketing_enrollments[]

  @@index([status])
  @@index([triggerKey])
}

model marketing_sequence_steps {
  id          Int                    @id @default(autoincrement())
  pidStep     String                 @unique @db.VarChar(80)
  sequenceId  Int
  stepNumber  Int
  delayDays   Int                    @default(0)
  title       String                 @db.VarChar(200)
  subject     String                 @db.VarChar(255)
  previewText String?                @db.VarChar(500)
  bodyText    String                 @db.LongText
  ctaLabel    String?                @db.VarChar(255)
  ctaUrl      String?                @db.VarChar(1000)
  status      String                 @default("ACTIVE") @db.VarChar(40)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  sequence    marketing_sequences    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  deliveries  marketing_deliveries[]

  @@unique([sequenceId, stepNumber])
  @@index([status])
}

model marketing_enrollments {
  id            Int                    @id @default(autoincrement())
  pidEnrollment String                 @unique @db.VarChar(80)
  contactId     Int
  sequenceId    Int
  status        String                 @default("ACTIVE") @db.VarChar(40)
  currentStep   Int                    @default(0)
  nextSendAt    DateTime?
  enrolledAt    DateTime               @default(now())
  lastSentAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  contact       marketing_contacts     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence      marketing_sequences    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  deliveries    marketing_deliveries[]

  @@unique([contactId, sequenceId])
  @@index([status, nextSendAt])
}

model marketing_campaigns {
  id           Int                    @id @default(autoincrement())
  pidCampaign  String                 @unique @db.VarChar(80)
  name         String                 @db.VarChar(180)
  subject      String                 @db.VarChar(255)
  previewText  String?                @db.VarChar(500)
  bodyText     String                 @db.LongText
  ctaLabel     String?                @db.VarChar(255)
  ctaUrl       String?                @db.VarChar(1000)
  audienceType String                 @default("TEST") @db.VarChar(40)
  status       String                 @default("DRAFT") @db.VarChar(40)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdBy    String?                @db.VarChar(80)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deliveries   marketing_deliveries[]

  @@index([status, scheduledAt])
}

model marketing_deliveries {
  id             Int                       @id @default(autoincrement())
  pidDelivery    String                    @unique @db.VarChar(80)
  contactId      Int?
  campaignId     Int?
  sequenceStepId Int?
  enrollmentId   Int?
  provider       String                    @default("SES") @db.VarChar(40)
  mode           String                    @default("SANDBOX") @db.VarChar(40)
  status         String                    @default("QUEUED") @db.VarChar(40)
  recipientEmail String                    @db.VarChar(255)
  subject        String                    @db.VarChar(255)
  idempotencyKey String                    @unique @db.VarChar(191)
  sesMessageId   String?                   @unique @db.VarChar(255)
  errorMessage   String?                   @db.Text
  scheduledAt    DateTime?
  attemptedAt    DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  bouncedAt      DateTime?
  complainedAt   DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  contact        marketing_contacts?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign       marketing_campaigns?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceStep   marketing_sequence_steps? @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  enrollment     marketing_enrollments?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  events         marketing_events[]

  @@index([status, scheduledAt])
  @@index([recipientEmail])
  @@index([campaignId])
  @@index([sequenceStepId])
}

model marketing_events {
  id           Int                   @id @default(autoincrement())
  pidEvent     String                @unique @db.VarChar(80)
  dedupeKey    String                @unique @db.VarChar(191)
  deliveryId   Int?
  sesMessageId String?               @db.VarChar(255)
  eventType    String                @db.VarChar(60)
  payload      Json
  occurredAt   DateTime?
  createdAt    DateTime              @default(now())
  delivery     marketing_deliveries? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([sesMessageId])
}

model admin {
  id                Int                 @id @default(autoincrement())
  pidUser           String              @unique()
  userFirstname     String?
  userLastname      String?
  userEmail         String              @unique()
  userPassword      String?
  userSession       String?
  userPhone         Int?
  userCid           String?
  userStatus        String?
  userAffiliateCode String?
  userAffiliateRef  String?
  userImage         String?
  userFile          String?
  userExt1          String?
  userExt2          String?
  xStaus            String?
  createdAt         DateTime?           @default(now())
