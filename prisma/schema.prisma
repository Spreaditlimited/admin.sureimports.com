model invoice_audit_logs {
  id          Int      @id @default(autoincrement())
  pidAuditLog String   @unique()
  pidInvoice  String
  pidUser     String?
  action      String
  oldStatus   String?
  newStatus   String?
  metadata    String?  @db.LongText
  createdAt   DateTime @default(now())
  invoice     invoices @relation(fields: [pidInvoice], references: [pidInvoice], onDelete: Cascade)
  user        users?   @relation(fields: [pidUser], references: [pidUser], onDelete: SetNull)

  @@index([pidInvoice])
  @@index([pidUser])
  @@index([createdAt])
}

model intelligence_report_products {
  id                    Int       @id @default(autoincrement())
  pidReport             String    @unique() @db.VarChar(80)
  nicheId               String    @unique() @db.VarChar(80)
  slug                  String    @unique() @db.VarChar(180)
  title                 String    @db.VarChar(220)
  subtitle              String?   @db.VarChar(255)
  description           String?   @db.Text
  editionLabel          String    @db.VarChar(120)
  coverImageUrl         String?   @db.VarChar(1000)
  coverImagePublicId    String?   @db.VarChar(500)
  coverImageBytes       Int?
  seoProfile            Json?
  priceNaira            Int
  priceUsdCents         Int
  status                String    @default("draft") @db.VarChar(40)
  automationStatus      String    @default("idle") @db.VarChar(40)
  automationError       String?   @db.Text
  automationStartedAt   DateTime?
  automationCompletedAt DateTime?
  currentVersionId      String?   @db.VarChar(80)
  supplierCount         Int       @default(0)
  publishedAt           DateTime?
  createdByPidUser      String?   @db.VarChar(191)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  @@index([status, publishedAt])
  @@index([currentVersionId])
}

model intelligence_report_price_settings {
  id            Int      @id @default(autoincrement())
  settingKey    String   @unique @db.VarChar(80)
  priceNaira    Int
  priceUsdCents Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model intelligence_report_versions {
  id                 Int       @id @default(autoincrement())
  pidVersion         String    @unique() @db.VarChar(80)
  reportId           String    @db.VarChar(80)
  versionNumber      Int
  editionLabel       String    @db.VarChar(120)
  supplierSnapshot   Json
  supplierCount      Int       @default(0)
  pdfUrl             String?   @db.VarChar(1000)
  pdfPublicId        String?   @db.VarChar(500)
  fileBytes          Int?
  status             String    @default("generated") @db.VarChar(40)
  generatedByPidUser String?   @db.VarChar(191)
  generatedAt        DateTime  @default(now())
  approvedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())

  @@unique([reportId, versionNumber])
  @@index([reportId, status])
}

model intelligence_report_orders {
  id                       Int       @id @default(autoincrement())
  pidOrder                 String    @unique() @db.VarChar(80)
  reportId                 String    @db.VarChar(80)
  versionId                String    @db.VarChar(80)
  pidUser                  String?   @db.VarChar(191)
  email                    String    @db.VarChar(255)
  firstName                String?   @db.VarChar(120)
  lastName                 String?   @db.VarChar(120)
  billingCountry           String?   @db.VarChar(120)
  paymentProvider          String    @db.VarChar(40)
  providerReference        String?   @unique() @db.VarChar(160)
  status                   String    @default("pending") @db.VarChar(40)
  amountMinor              Int
  currency                 String    @db.VarChar(10)
  downloadToken            String    @unique() @db.VarChar(160)
  downloadTokenExpiresAt   DateTime?
  downloadCount            Int       @default(0)
  paidAt                   DateTime?
  fulfilledAt              DateTime?
  fulfillmentClaimedAt     DateTime?
  fulfillmentAttempts      Int       @default(0)
  lastFulfillmentAttemptAt DateTime?
  fulfillmentError         String?   @db.Text
  providerCaptureReference String?   @unique() @db.VarChar(160)
  refundedAt               DateTime?
  revokedAt                DateTime?
  revocationReason         String?   @db.VarChar(500)
  lastProviderEvent        String?   @db.VarChar(160)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now())

  @@index([reportId, status])
  @@index([versionId])
  @@index([pidUser, status])
  @@index([email, status])
  @@index([status, fulfilledAt, lastFulfillmentAttemptAt], map: "iro_fulfillment_queue_idx")
}

model intelligence_report_checkout_rate_limits {
  id          Int      @id @default(autoincrement())
  scopeHash   String   @db.VarChar(64)
  bucketStart DateTime
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([scopeHash, bucketStart], map: "ircrl_scope_bucket_key")
  @@index([updatedAt], map: "ircrl_updated_idx")
}

model intelligence_report_order_events {
  id              Int      @id @default(autoincrement())
  pidEvent        String   @unique() @db.VarChar(80)
  orderId         String   @db.VarChar(80)
  source          String   @db.VarChar(40)
  eventType       String   @db.VarChar(120)
  providerEventId String?  @unique() @db.VarChar(160)
  previousStatus  String?  @db.VarChar(40)
  nextStatus      String?  @db.VarChar(40)
  details         Json?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt], map: "iroe_order_created_idx")
  @@index([eventType, createdAt], map: "iroe_type_created_idx")
}

model intelligence_report_requests {
  id                   Int                                 @id @default(autoincrement())
  pidRequest           String                              @unique() @db.VarChar(80)
  query                String                              @db.VarChar(180)
  normalizedQuery      String                              @unique() @db.VarChar(180)
  status               String                              @default("requested") @db.VarChar(40)
  voteCount            Int                                 @default(0)
  selectedWeek         String?                             @db.VarChar(20)
  queueSearchRequestId String?                             @db.VarChar(80)
  publishedReportSlug  String?                             @db.VarChar(180)
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @default(now()) @updatedAt
  votes                intelligence_report_request_votes[]

  @@index([status, voteCount])
  @@index([selectedWeek])
  @@index([queueSearchRequestId])
}

model intelligence_report_request_votes {
  id        Int                          @id @default(autoincrement())
  pidVote   String                       @unique() @db.VarChar(80)
  requestId String                       @db.VarChar(80)
  email     String                       @db.VarChar(255)
  voterKey  String                       @db.VarChar(64)
  weekKey   String                       @db.VarChar(20)
  createdAt DateTime                     @default(now())
  request   intelligence_report_requests @relation(fields: [requestId], references: [pidRequest], onDelete: Cascade)

  @@unique([requestId, voterKey, weekKey])
  @@index([weekKey, createdAt])
  @@index([email])
}
